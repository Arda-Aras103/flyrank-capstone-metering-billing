# Application Settings
APP_ENV=development
PORT=8000
APP_BASE_URL=http://localhost:8000

# Database Configuration
# Default uses SQLite for zero-config single-command startup.
# For Docker PostgreSQL, use: postgresql+psycopg://postgres:postgres@localhost:5432/metering_billing
DATABASE_URL=sqlite:///./metering_billing.db

# Stripe Configuration (Test Mode ONLY - never commit real or test secrets)
STRIPE_SECRET_KEY=sk_test_placeholder_replace_in_env
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_in_env
STRIPE_PRO_PRICE_ID=price_test_pro_plan_placeholder

# Pinned Plan Quotas (Monthly)
FREE_PLAN_API_CALLS_LIMIT=1000
FREE_PLAN_AI_TOKENS_LIMIT=100000
PRO_PLAN_API_CALLS_LIMIT=50000
PRO_PLAN_AI_TOKENS_LIMIT=5000000

# Pinned Plan Base Subscription Prices (Integer Cents)
FREE_PLAN_BASE_PRICE_CENTS=0
PRO_PLAN_BASE_PRICE_CENTS=4900

# Pinned Pricing Constants (Integer Micro-Cents, where 1 USD = 100 cents = 1,000,000 micro-cents)
# API Calls: 1,000 micro-cents per API call ($0.001 / call = $1.00 per 1,000 calls)
PRICE_PER_API_CALL_MICROCENTS=1000
# Fresh Input Tokens: 2 micro-cents per token ($2.00 / 1M tokens)
PRICE_INPUT_TOKEN_MICROCENTS=2
# Cached Input Tokens: 1 micro-cent per token ($1.00 / 1M tokens — 50% cheaper than fresh input)
PRICE_CACHED_INPUT_TOKEN_MICROCENTS=1
# Output & Reasoning Tokens: 8 micro-cents per token ($8.00 / 1M tokens — reasoning tokens count as output)
PRICE_OUTPUT_TOKEN_MICROCENTS=8

# Background Job Settings
RECONCILIATION_MAX_RETRIES=3
USAGE_ALERT_WARN_THRESHOLD_PCT=80
USAGE_ALERT_LIMIT_THRESHOLD_PCT=100
